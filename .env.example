# QueueLess environment variables (placeholders only - never commit real values).
# In production, set these as private environment variables on the host (e.g. Render).

# Spring profile: dev (local), prod (hosted)
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL. JDBC form with separate credentials (preferred):
DATABASE_URL=jdbc:postgresql://YOUR-NEON-HOST.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=your_database_user
DATABASE_PASSWORD=your_database_password
# ...or a single provider URL with embedded credentials (then leave the two above empty):
# DATABASE_URL=postgresql://user:password@YOUR-NEON-HOST.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Optional demo data (two organizations, staff, admins, customers)
QUEUELESS_SEED_DEMO_DATA=false
QUEUELESS_SEED_PASSWORD=choose-a-demo-password

# Optional: hide /swagger-ui.html and /v3/api-docs
# QUEUELESS_API_DOCS_ENABLED=false

# Port (Render injects PORT automatically)
# PORT=8080
